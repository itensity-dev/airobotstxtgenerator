# Caddy inside the web container: serves the static build on :8080 and proxies /api/* to the api service.
# TLS is terminated in front of it (see deploy/Caddyfile.vps) — this server speaks plain HTTP.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
	log {
		output stdout
		format console
		level WARN
	}
}

:8080 {
	root * /srv

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8081} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		# Hashed build assets never change.
		@immutable path /_astro/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Everything else (HTML, Markdown, robots.txt, sitemaps, JSON) is revalidated on each visit.
		@mutable not path /_astro/*
		header @mutable Cache-Control "no-cache"

		@md path *.md
		header @md Content-Type "text/markdown; charset=utf-8"
		@txt path *.txt
		header @txt Content-Type "text/plain; charset=utf-8"
		@manifest path *.webmanifest
		header @manifest Content-Type "application/manifest+json"
		@sw path /sw.js
		header @sw Cache-Control "no-cache"

		file_server {
			precompressed br gzip
		}
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		# Script and style sources are restricted per page by a hashed CSP <meta> tag generated by Astro;
		# this header adds the directives a <meta> CSP cannot carry.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
