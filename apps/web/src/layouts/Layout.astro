---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import franklinLatin from '../fonts/libre-franklin-latin-wght-normal.woff2?url';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { LOCALE_INFO, PUBLISHED_LOCALES, type Locale } from '../i18n/locales';
import { t } from '../i18n';
import { BRAND, SITE_URL, GSC_VERIFICATION, BING_VERIFICATION } from '../config/site';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page, with trailing slash. */
  path: string;
  /** Equivalent paths in other languages (locale → path). */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  markdown?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  navCurrent?: string;
  ogType?: 'website' | 'article';
}
const {
  locale,
  title,
  description,
  path,
  alternates = {},
  ogImage,
  markdown,
  jsonLd = [],
  noindex = false,
  navCurrent,
  ogType = 'website',
} = Astro.props;
const info = LOCALE_INFO[locale];
const canonical = SITE_URL + path;
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;
const alts = PUBLISHED_LOCALES.filter((l) => alternates[l]).map((l) => ({
  l,
  href: SITE_URL + alternates[l],
}));
const xDefault = alternates.en ? SITE_URL + alternates.en : null;
const ogUrl = ogImage ? SITE_URL + ogImage : undefined;
---

<!doctype html>
<html lang={info.hreflang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex &&
      alts.map(({ l, href }) => (
        <link rel="alternate" hreflang={LOCALE_INFO[l].hreflang} href={href} />
      ))}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="preload" href={franklinLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f5f0e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={info.og} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    {BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch {
          /* storage unavailable */
        }
      })();
    </script>
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(locale, 'site.skip')}
    </a>
    <div class="wrap">
      <Masthead locale={locale} alternates={alternates} current={navCurrent} />
      <LangBanner locale={locale} alternates={alternates} />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer locale={locale} />
    <ConsentBanner />
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
