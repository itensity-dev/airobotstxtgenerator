---
import {
  ADS_ENABLED,
  ADSENSE_CLIENT,
  ANALYTICS_PROVIDER,
  GA4_ID,
  PLAUSIBLE_DOMAIN,
  PLAUSIBLE_SRC,
} from '../config/site';
// Plausible: cookie-free, loaded directly. GA4: loaded only after the visitor consents (see ConsentBanner).
---

{ANALYTICS_PROVIDER === 'plausible' && (
  <script defer data-domain={PLAUSIBLE_DOMAIN} src={PLAUSIBLE_SRC}></script>
)}
{ANALYTICS_PROVIDER === 'ga4' && GA4_ID && <meta name="ga4-id" content={GA4_ID} />}
{ADS_ENABLED && ADSENSE_CLIENT && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
    crossorigin="anonymous"
  ></script>
)}
