---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
const colors = ['paper', 'paper-2', 'paper-3', 'ink', 'ink-2', 'ink-3', 'rule', 'rule-light', 'red', 'red-wash', 'green', 'green-wash', 'amber', 'amber-wash'];
const sizes = ['xs', 'sm', 'code', 'base', 'md', 'lg', 'xl', '2xl', '3xl'];
const spaces = [1, 2, 3, 4, 5, 6, 7, 8];
---
<Layout locale="en" title="Style guide" description="Design tokens and components of AI Robots.txt Generator." path="/styleguide/" noindex>
  <PageHead h1="Style guide" lead="Design tokens and components — “Gazette” direction. This page is not indexed." />
  <h2>Colour</h2>
  <div class="sg-swatches">
    {colors.map((c) => <div class={`sg-swatch sg-c-${c}`}><span class="mono small">--{c}</span></div>)}
  </div>
  <h2>Type</h2>
  <p class="kicker">Display — Old Standard TT 700</p>
  <p class="sg-display">Register of AI crawlers · Реестр ИИ-краулеров</p>
  <p class="kicker">Text — Libre Franklin</p>
  <p class="prose">robots.txt is a notice addressed to machines. Crawlers that follow RFC 9309 read the group that names them, take the longest matching rule, and let Allow win a tie. Zażółć gęślą jaźń. Съешь же ещё этих мягких французских булок.</p>
  <p class="kicker">Mono — IBM Plex Mono</p>
  <pre>User-agent: GPTBot
Disallow: /
Allow: /blog/</pre>
  <table class="register">
    <thead><tr><th>Token</th><th>Size</th><th>Sample</th></tr></thead>
    <tbody>{sizes.map((s) => <tr><td class="mono">--fs-{s}</td><td class="num">{s}</td><td class={`sg-fs-${s}`}>Aa Ää Ąą Жж</td></tr>)}</tbody>
  </table>
  <h2>Space and lines</h2>
  <div class="sg-spaces">{spaces.map((s) => <div class={`sg-space sg-s-${s}`}><span class="mono small">--s-{s}</span></div>)}</div>
  <p><span class="sg-line sg-line-hair"></span> hairline 1px · <span class="sg-line sg-line-rule"></span> rule 2px · <span class="sg-line sg-line-heavy"></span> heavy 4px · radius 0</p>
  <h2>Stamps</h2>
  <p class="row"><span class="stamp stamp--ok">Allowed</span> <span class="stamp stamp--no">Blocked</span> <span class="stamp stamp--part">Partial</span> <span class="stamp stamp--info">No rules</span> <span class="stamp stamp--ok stamp--big">Verified: 47 agents × 4 paths</span></p>
  <h2>Controls</h2>
  <p class="row"><button class="btn" type="button">Primary</button> <button class="btn btn--ghost" type="button">Secondary</button> <button class="btn btn--small" type="button">Small</button></p>
  <div class="field"><label for="sg-in">Website or URL</label><input id="sg-in" type="text" placeholder="example.com" /><span class="field__hint">Hint text in secondary ink.</span></div>
  <div class="choices"><label class="choice"><input type="radio" name="sg" checked /><span><strong>Blog</strong><span class="choice__hint">Articles</span></span></label><label class="choice"><input type="radio" name="sg" /><span><strong>Shop</strong><span class="choice__hint">Cart, checkout</span></span></label></div>
  <h2>Callouts</h2>
  <p class="callout">Neutral note.</p>
  <p class="callout callout--warn">Warning: AI search visibility lost.</p>
  <p class="callout callout--ok">Unchanged for existing agents.</p>
  <h2>Register table</h2>
  <div class="table-wrap"><table class="register"><thead><tr><th>Agent</th><th>Purpose</th><th>Home page</th></tr></thead><tbody>
    <tr class="is-blocked"><td class="mono">GPTBot</td><td>AI training</td><td><span class="stamp stamp--no">Blocked</span></td></tr>
    <tr class="is-allowed"><td class="mono">OAI-SearchBot</td><td>AI search</td><td><span class="stamp stamp--ok">Allowed</span></td></tr>
    <tr class="is-partial"><td class="mono">CCBot</td><td>AI training</td><td><span class="stamp stamp--part">Partial</span></td></tr>
  </tbody></table></div>
  <div class="ad-slot">Reserved ad slot 336×280 (off by default)</div>
</Layout>
<style>
  .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); margin-bottom: var(--s-5); }
  .sg-swatch { height: 84px; display: flex; align-items: flex-end; padding: var(--s-2); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .sg-swatch span { background: var(--paper); padding: 0 4px; }
  .sg-c-paper { background: var(--paper); } .sg-c-paper-2 { background: var(--paper-2); } .sg-c-paper-3 { background: var(--paper-3); }
  .sg-c-ink { background: var(--ink); } .sg-c-ink-2 { background: var(--ink-2); } .sg-c-ink-3 { background: var(--ink-3); }
  .sg-c-rule { background: var(--rule); } .sg-c-rule-light { background: var(--rule-light); }
  .sg-c-red { background: var(--red); } .sg-c-red-wash { background: var(--red-wash); } .sg-c-green { background: var(--green); } .sg-c-green-wash { background: var(--green-wash); }
  .sg-c-amber { background: var(--amber); } .sg-c-amber-wash { background: var(--amber-wash); }
  .sg-display { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-2xl); line-height: 1.1; }
  .sg-fs-xs { font-size: var(--fs-xs); } .sg-fs-sm { font-size: var(--fs-sm); } .sg-fs-code { font-size: var(--fs-code); } .sg-fs-base { font-size: var(--fs-base); } .sg-fs-md { font-size: var(--fs-md); } .sg-fs-lg { font-size: var(--fs-lg); } .sg-fs-xl { font-size: var(--fs-xl); } .sg-fs-2xl { font-size: var(--fs-2xl); } .sg-fs-3xl { font-size: var(--fs-3xl); }
  .sg-spaces { display: flex; align-items: flex-end; gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-4); }
  .sg-space { background: var(--ink); color: var(--paper); }
  .sg-space span { display: block; transform: translateY(1.4em); color: var(--ink); white-space: nowrap; }
  .sg-s-1 { width: 4px; height: 4px; } .sg-s-2 { width: 8px; height: 8px; } .sg-s-3 { width: 12px; height: 12px; } .sg-s-4 { width: 16px; height: 16px; } .sg-s-5 { width: 24px; height: 24px; } .sg-s-6 { width: 32px; height: 32px; } .sg-s-7 { width: 48px; height: 48px; } .sg-s-8 { width: 64px; height: 64px; }
  .sg-line { display: inline-block; width: 60px; vertical-align: middle; background: var(--rule); }
  .sg-line-hair { height: 1px; } .sg-line-rule { height: 2px; } .sg-line-heavy { height: 4px; }
</style>
