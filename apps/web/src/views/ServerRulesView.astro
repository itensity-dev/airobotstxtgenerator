---
import { curatedBots, getOperator, type ServerTarget } from '@airobots/core';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import PageSections from '../components/PageSections.astro';
import ServerRules from '../islands/ServerRules';
import { pick, t } from '../i18n';
import { botPath, pathFor, type PageId } from '../i18n/routes';
import { getPage } from '../lib/content';
import { resolveLinksInHtml } from '../lib/links';
import { alternatesFor, type SitePage } from '../lib/pages';
import { breadcrumbList, faqPage, webApplication } from '../lib/seo';
import { crumbsFor, genBots, mdPath, ogPath } from '../lib/view';
import { SITE_URL } from '../config/site';

interface Props {
  page: SitePage;
}
const { page } = Astro.props;
const { locale } = page;
const id = page.id as PageId;
const mod = getPage(locale, id)!;
const fm = mod.frontmatter;
const body = resolveLinksInHtml(await mod.compiledContent(), locale);
const crumbs = crumbsFor(locale, id);
const targetFor: Record<string, ServerTarget> = {
  'server-rules': 'nginx',
  'server-nginx': 'nginx',
  'server-apache': 'apache',
  'server-caddy': 'caddy',
  'server-cloudflare': 'cloudflare',
  'server-frameworks': 'express',
};
const targets: ServerTarget[] | undefined = id === 'server-frameworks' ? ['express', 'nextjs', 'django', 'php'] : id === 'server-rules' ? undefined : [targetFor[id]!];
const verifiable = curatedBots.filter((b) => b.verification !== 'none' && (b.ipRanges || b.verifyHosts));
const jsonLd = [webApplication({ name: fm.h1, description: fm.description, url: SITE_URL + page.path, locale }), breadcrumbList(crumbs), ...(fm.faq?.length ? [faqPage(fm.faq)] : [])];
const dict = pick(locale, ['server.', 'common.', 'purpose.']);
const subpages: PageId[] = ['server-nginx', 'server-apache', 'server-caddy', 'server-cloudflare', 'server-frameworks'];
---
<Layout locale={locale} title={fm.title} description={fm.description} path={page.path} alternates={alternatesFor(id)} ogImage={ogPath(page)} markdown={mdPath(page)} jsonLd={jsonLd} navCurrent="server-rules">
  <PageHead h1={fm.h1} lead={fm.lead} crumbs={crumbs} />
  <p class="small row">
    {subpages.map((s) => (s === id ? <strong>{getPage(locale, s)?.frontmatter.nav}</strong> : <a href={pathFor(locale, s)}>{getPage(locale, s)?.frontmatter.nav}</a>))}
  </p>
  <ServerRules client:visible dict={dict} bots={genBots()} initialTarget={targetFor[id]!} targets={targets} />
  <PageSections locale={locale} fm={fm}>
    <Fragment set:html={body} />
    {id === 'server-rules' && (
      <>
        <h2 id="verify">{t(locale, 'server.ipTitle')}</h2>
        <div class="table-wrap">
          <table class="register">
            <thead><tr><th scope="col">{t(locale, 'bots.colName')}</th><th scope="col">{t(locale, 'bots.colOperator')}</th><th scope="col">{t(locale, 'bots.colVerify')}</th></tr></thead>
            <tbody>
              {verifiable.map((b) => (
                <tr>
                  <th scope="row" class="mono">{b.page ? <a href={botPath(locale, b.id)}>{b.token}</a> : b.token}</th>
                  <td>{getOperator(b.operator)?.name}</td>
                  <td class="small">{b.ipRanges ? <a href={b.ipRanges} rel="noopener nofollow">{b.ipRanges.replace(/^https:\/\//, '')}</a> : null}{b.ipRanges && b.verifyHosts ? ' · ' : ''}{b.verifyHosts ? b.verifyHosts.map((h) => <code>{h}</code>) : null}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </PageSections>
</Layout>
