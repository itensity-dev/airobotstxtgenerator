{
  "name": "@airobots/api",
  "version": "1.0.0",
  "private": true,
  "description": "Fetches robots.txt files for the airobotstxtgenerator.com tester, with SSRF protection, limits, rate limiting and a short cache.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
