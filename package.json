{
  "name": "airobotstxtgenerator",
  "private": true,
  "version": "1.0.0",
  "description": "AI robots.txt generator, robots.txt tester and AI crawler registry — airobotstxtgenerator.com",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @airobots/web dev",
    "dev:api": "pnpm --filter @airobots/api dev",
    "build": "pnpm --filter @airobots/core build && pnpm --filter @airobots/api build && pnpm --filter @airobots/web build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @airobots/web test:e2e",
    "i18n:check": "pnpm --filter @airobots/web i18n:check",
    "bots:sync": "pnpm --filter @airobots/core bots:sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
