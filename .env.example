# Copy to .env and adjust. Variables marked (build) are baked into the static site at image build time:
# change them, then rebuild the web image (`docker compose build web`).

# Public address of the site, without trailing slash. Used for canonical URLs, hreflang, sitemaps, OG. (build)
SITE_URL=https://airobotstxtgenerator.com

# Analytics: none | plausible | ga4. Plausible is cookie-free; GA4 loads only after consent. (build)
ANALYTICS_PROVIDER=none
# Domain registered in Plausible (defaults to the host of SITE_URL). (build)
PLAUSIBLE_DOMAIN=airobotstxtgenerator.com
# Plausible script URL; change it if you self-host Plausible. (build)
PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
# GA4 measurement ID (only with ANALYTICS_PROVIDER=ga4). (build)
GA4_ID=

# Advertising is off by default. When true, reserved ad slots are filled and the CSP allows AdSense;
# EEA/UK visitors need a Google-certified CMP — configure it in AdSense before switching on. (build)
ADS_ENABLED=false
# AdSense publisher ID, e.g. ca-pub-1234567890123456. (build)
ADSENSE_CLIENT=

# Search engine verification meta tags (content values only). (build)
GSC_VERIFICATION=
BING_VERIFICATION=

# IndexNow key (8–128 hex characters). The key file /<key>.txt is published and scripts/indexnow.mjs
# notifies Bing, Yandex and others about changed URLs after a deploy. (build)
INDEXNOW_KEY=

# Contact shown on About, Privacy and the checker-bot page. (build)
CONTACT_EMAIL=contact@airobotstxtgenerator.com
# Optional author name for the About page and Organization JSON-LD. (build)
AUTHOR_NAME=

# api service: requests per client IP for live checks, e.g. 30/min, 300/hour.
API_RATE_LIMIT=30/min
# User-Agent of the checker; default: Mozilla/5.0 (compatible; AIRobotsTxtChecker/1.0; +https://airobotstxtgenerator.com/checker-bot)
API_USER_AGENT=
# Cache lifetime for fetched robots.txt files, seconds.
API_CACHE_TTL_SECONDS=600

# Host port for the web container.
WEB_PORT=8080

# VPS edge (docker compose --profile vps up -d): domains and ACME account e-mail.
SITE_DOMAIN=airobotstxtgenerator.com
ALT_DOMAIN=aicrawlerblocker.com
ACME_EMAIL=

# Images: pulled from GHCR by default; change to pin a version for rollback (e.g. :1.0.0 or :sha-abc1234).
WEB_IMAGE=ghcr.io/itensity-dev/airobotstxtgenerator-web:latest
API_IMAGE=ghcr.io/itensity-dev/airobotstxtgenerator-api:latest
# Base images (override with a mirror if Docker Hub rate-limits you, e.g. mirror.gcr.io/library/node:26-alpine).
NODE_IMAGE=node:26-alpine
CADDY_IMAGE=caddy:2-alpine
ALPINE_IMAGE=alpine:3.22
